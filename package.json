{
  "name": "human-hindsight",
  "version": "2.1.3",
  "description": "Reflect on your coding-agent history to see how you work. Find preferences in your own words, reuse prompts, and suggest specialist agents when you need them.",
  "type": "module",
  "author": "Aditya Singhal (https://adityasinghal.com)",
  "license": "MIT",
  "keywords": [
    "coding-agents",
    "agent-history",
    "preferences",
    "subagents",
    "prompt-library",
    "claude-code",
    "codex",
    "kiro-cli",
    "kiro-crew",
    "opencode",
    "local-first",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaarunsinghal/human-hindsight.git"
  },
  "homepage": "https://adityasinghal.com/#current",
  "bugs": {
    "url": "https://github.com/adityaarunsinghal/human-hindsight/issues"
  },
  "bin": {
    "human-hindsight": "launcher/cli.cjs"
  },
  "files": [
    "dist",
    "launcher/cli.cjs"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build --silent 1>&2",
    "test": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:budget": "node scripts/check-test-budget.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/require-staged-publish.mjs",
    "stage:release": "node scripts/stage-release.mjs"
  },
  "dependencies": {
    "citty": "0.2.2",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "marked": "18.1.1",
    "smol-toml": "1.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./cli": "./dist/cli.js",
    "./launcher/cli.cjs": "./launcher/cli.cjs",
    "./package.json": "./package.json"
  }
}
