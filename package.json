{
  "name": "human-hindsight",
  "version": "1.6.0",
  "description": "Mine your coding-agent session history (Claude Code, Codex, kiro-cli) into a oneshot prompt library and CLAUDE.md/AGENTS.md preferences. The prompt you'd write if you knew then what you know now.",
  "type": "module",
  "author": "Aditya Singhal (https://adityasinghal.com)",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "kiro",
    "kiro-cli",
    "agents",
    "prompt",
    "prompt-library",
    "prompt-engineering",
    "cli",
    "transcripts",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaarunsinghal/human-hindsight.git"
  },
  "homepage": "https://github.com/adityaarunsinghal/human-hindsight#readme",
  "bugs": {
    "url": "https://github.com/adityaarunsinghal/human-hindsight/issues"
  },
  "bin": {
    "human-hindsight": "./dist/cli.js"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build --silent 1>&2",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run --json --ignore-scripts > pack.json && node scripts/check-pack.mjs pack.json && rm pack.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "citty": "0.2.2",
    "smol-toml": "1.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  }
}
